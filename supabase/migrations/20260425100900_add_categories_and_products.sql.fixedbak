/*
  # Add Categories and Sample Products
  
  ## Categories to Add
  - Ordinateurs
  - Imprimantes  
  - Accessoires
  - Téléphones
  
  ## Sample Products
  Adding realistic products for each category with appropriate pricing in FCFA
*/

-- Insert categories (if they don't exist)
INSERT INTO categories (name, slug) VALUES 
  ('Ordinateurs', 'ordinateurs'),
  ('Imprimantes', 'imprimantes'),
  ('Accessoires', 'accessoires'),
  ('Téléphones', 'telephones')
ON CONFLICT (slug) DO NOTHING;

-- Insert sample products for Ordinateurs
INSERT INTO products (name, description, price, category_id, brand, image_url, available, popular) 
SELECT 
  src.name, 
  src.description, 
  src.price, 
  c.id as category_id,
  src.brand,
  src.image_url,
  src.available,
  src.popular
FROM (VALUES 
  ('Dell Latitude 5420', 'Ordinateur portable professionnel avec processeur Intel Core i5, 8GB RAM, 256GB SSD. Écran 14" Full HD, clavier rétroéclairé.', 285000, 'ordinateurs', 'Dell', '/products/dell-latitude-5420.png', true, true),
  ('HP Pavilion 15', 'Ordinateur portable avec processeur AMD Ryzen 5, 16GB RAM, 512GB SSD. Écran 15.6" HD, webcam HD.', 245000, 'ordinateurs', 'HP', '/products/hp-pavilion-15.png', true, false),
  ('Lenovo ThinkPad E14', 'PC portable robuste avec Intel Core i3, 8GB RAM, 256GB SSD. Écran 14" anti-reflets.', 195000, 'ordinateurs', 'Lenovo', '/products/lenovo-thinkpad-e14.png', true, false),
  ('MacBook Air M1', 'Ordinateur portable Apple avec chip M1, 8GB RAM, 256GB SSD. Écran 13.3" Retina.', 450000, 'ordinateurs', 'Apple', '/products/macbook-air-m1.png', true, true),
  ('Asus VivoBook 15', 'PC portable avec Intel Core i5, 8GB RAM, 512GB SSD. Écran 15.6" Full HD, pavé tactile numérique.', 220000, 'ordinateurs', 'ASUS', '/products/asus-vivobook-15.png', true, false)
) AS src(name, description, price, category_slug, brand, image_url, available, popular)
JOIN categories c ON c.slug = src.category_slug;

-- Insert sample products for Imprimantes
INSERT INTO products (name, description, price, category_id, brand, image_url, available, popular) 
SELECT 
  src.name, 
  src.description, 
  src.price, 
  c.id as category_id,
  src.brand,
  src.image_url,
  src.available,
  src.popular
FROM (VALUES 
  ('HP LaserJet Pro M404n', 'Imprimante laser monochrome, vitesse 40 ppm, résolution 1200 dpi, WiFi, USB.', 125000, 'imprimantes', 'HP', '/products/hp-laserjet-pro-m404n.png', true, true),
  ('Canon Pixma TS3320', 'Imprimante multifonction jet d''encre, scan, copie, WiFi, résolution 4800 x 1200 dpi.', 45000, 'imprimantes', 'Canon', '/products/canon-pixma-ts3320.png', true, false),
  ('Epson EcoTank L3150', 'Imprimante jet d''encre avec système de réservoir, impression recto-verso, WiFi.', 85000, 'imprimantes', 'Epson', '/products/epson-ecotank-l3150.png', true, false),
  ('Brother MFC-L2710DW', 'Imprimante laser monochrome multifonction, scan, copie, fax, WiFi.', 155000, 'imprimantes', 'Brother', '/products/brother-mfc-l2710dw.png', true, true),
  ('Xerox WorkCentre 3335', 'Imprimante laser multifonction couleur, vitesse 35 ppm, scan, copie, WiFi.', 285000, 'imprimantes', 'Xerox', '/products/xerox-workcentre-3335.png', true, false)
) AS src(name, description, price, category_slug, brand, image_url, available, popular)
JOIN categories c ON c.slug = src.category_slug;

-- Insert sample products for Accessoires
INSERT INTO products (name, description, price, category_id, brand, image_url, available, popular) 
SELECT 
  src.name, 
  src.description, 
  src.price, 
  c.id as category_id,
  src.brand,
  src.image_url,
  src.available,
  src.popular
FROM (VALUES 
  ('Logitech MX Master 3', 'Souris sans fil avancée, capteur Darkfield 4000 DPI, scroll magnétique, 70 jours d''autonomie.', 45000, 'accessoires', 'Logitech', '/products/logitech-mx-master-3.png', true, true),
  ('Corsair K95 RGB', 'Clavier mécanique gaming, switches Cherry MX, rétroéclairage RGB, 6 touches programmables.', 75000, 'accessoires', 'Corsair', '/products/corsair-k95-rgb.png', true, false),
  ('Samsung SSD 870 EVO 1TB', 'Disque SSD SATA III, vitesse jusqu''à 560 Mo/s, garantie 5 ans.', 85000, 'accessoires', 'Samsung', '/products/samsung-ssd-870-evo-1tb.png', true, false),
  ('WD My Passport 2TB', 'Disque dur externe portable 2TB, USB 3.0, encryption matériel.', 55000, 'accessoires', 'Western Digital', '/products/wd-my-passport-2tb.png', true, false),
  ('JBL Quantum 400', 'Casque gaming, son 7.1 surround, micro detachable, compatible PC/Console.', 35000, 'accessoires', 'JBL', '/products/jbl-quantum-400.png', true, true),
  ('Anker PowerCore 20000', 'Batterie externe 20000mAh, charge rapide PowerIQ, double sortie USB.', 25000, 'accessoires', 'Anker', '/products/anker-powercore-20000.png', true, false)
) AS src(name, description, price, category_slug, brand, image_url, available, popular)
JOIN categories c ON c.slug = src.category_slug;

-- Insert sample products for Téléphones
INSERT INTO products (name, description, price, category_id, brand, image_url, available, popular) 
SELECT 
  src.name, 
  src.description, 
  src.price, 
  c.id as category_id,
  src.brand,
  src.image_url,
  src.available,
  src.popular
FROM (VALUES 
  ('iPhone 13', 'Smartphone Apple avec écran 6.1" Super Retina XDR, chip A15 Bionic, double appareil photo 12MP.', 285000, 'telephones', 'Apple', '/products/iphone-13.png', true, true),
  ('Samsung Galaxy S22', 'Smartphone Android avec écran 6.1" Dynamic AMOLED 2X, processeur Snapdragon 8 Gen 1, triple caméra 50MP.', 245000, 'telephones', 'Samsung', '/products/samsung-galaxy-s22.png', true, false),
  ('Xiaomi Redmi Note 11', 'Smartphone Android avec écran 6.43" FHD+, processeur Snapdragon 680, quadruple caméra 50MP.', 95000, 'telephones', 'Xiaomi', '/products/xiaomi-redmi-note-11.png', true, false),
  ('OnePlus 10 Pro', 'Smartphone Android avec écran 6.7" Fluid AMOLED, processeur Snapdragon 8 Gen 1, triple caméra Hasselblad.', 325000, 'telephones', 'OnePlus', '/products/oneplus-10-pro.png', true, true),
  ('Tecno Camon 19', 'Smartphone Android avec écran 6.8" HD+, processeur Helio G85, double caméra 64MP.', 65000, 'telephones', 'Tecno', '/products/tecno-camon-19.png', true, false),
  ('Nokia G50', 'Smartphone Android avec écran 6.82" HD+, batterie 5000mAh, triple caméra 48MP.', 85000, 'telephones', 'Nokia', '/products/nokia-g50.png', true, false)
) AS src(name, description, price, category_slug, brand, image_url, available, popular)
JOIN categories c ON c.slug = src.category_slug;
